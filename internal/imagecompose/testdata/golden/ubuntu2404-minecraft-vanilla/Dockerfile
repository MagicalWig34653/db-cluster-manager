      openjdk-25-jre-headless \
 && rm -rf /var/lib/apt/lists/*
RUN mkdir -p -m 0755 /opt/minecraft
ADD --checksum=sha256:d052f14d7a173734fba553711e5b570162e2f2a313267ee31a21b975a679be64 --chmod=0644 https://piston-data.mojang.com/v1/objects/33680f5f2ac32864d6d7cf5e56a705fdb3e05f4c/server.jar /opt/minecraft/server.jar
RUN echo "33680f5f2ac32864d6d7cf5e56a705fdb3e05f4c  /opt/minecraft/server.jar" > /tmp/server.jar.sha1 && sha1sum -c /tmp/server.jar.sha1 && rm -f /tmp/server.jar.sha1
RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app \
 && mkdir -p /data /etc/dbcm/minecraft \
