      dbcm.recipe-digest="sha256:e8bef5fc67f1e0435926ddd303e31da5738b449810f9889889bfbd67727a000d" \
      dbcm.catalog-version="2026.10.30-2" \
      dbcm.generator-version="2"
RUN apt-get update \
