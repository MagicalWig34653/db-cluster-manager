FROM docker.io/library/almalinux:9@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
LABEL org.opencontainers.image.title="ca rhel" \
      org.opencontainers.image.base.name="docker.io/library/almalinux:9" \
      org.opencontainers.image.base.digest="sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" \
      dbcm.recipe-digest="sha256:8e92e05e02dd3ebca54dc48cf07f394b7f9dd80c2778554f576a0a722caee750" \
      dbcm.catalog-version="2026.10.31-1" \
      dbcm.generator-version="2"
RUN dnf -y module enable nginx:1.26 \
 && dnf -y install --setopt=install_weak_deps=False --setopt=tsflags=nodocs \
      ca-certificates \
      glibc-langpack-en \
      nginx \
      tzdata \
 && dnf clean all && rm -rf /var/cache/dnf
COPY certs/extra-ca-1.crt /etc/pki/ca-trust/source/anchors/dbcm-extra-ca-1.crt
RUN update-ca-trust extract
RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app \
 && mkdir -p /var/log/nginx /var/www/html /etc/dbcm/nginx \
 && chown -R app:app /var/log/nginx /var/www/html
COPY nginx/nginx.conf /etc/dbcm/nginx/nginx.conf
COPY nginx/default.conf /etc/dbcm/nginx/default.conf
ENV HOME=/tmp
ENV LANG=en_US.UTF-8
ENV TZ=UTC
RUN nginx -t -c /etc/dbcm/nginx/nginx.conf && rm -rf /tmp/nginx.pid /tmp/nginx-*
USER 10001:10001
EXPOSE 8080
STOPSIGNAL SIGQUIT
CMD ["nginx", "-g", "daemon off;", "-c", "/etc/dbcm/nginx/nginx.conf"]
