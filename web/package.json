{
  "name": "db-cluster-manager-web",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:mock": "VITE_MOCK=1 vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:i18n": "node scripts/check_i18n.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.52.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "bits-ui": "2.19.5",
    "clsx": "2.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*.js": [
      "./src/lib/*.ts",
      "./src/lib/*.js"
    ],
    "#lib/*": [
      "./src/lib/*.ts",
      "./src/lib/*.svelte",
      "./src/lib/*"
    ]
  }
}
