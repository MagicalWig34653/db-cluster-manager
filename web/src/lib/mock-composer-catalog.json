        {"id": "ghostscript", "packages": {"alpine": ["ghostscript"], "debian": ["ghostscript"], "rhel": ["ghostscript"]}},
        {"id": "imagemagick", "packages": {"alpine": ["imagemagick"], "debian": ["imagemagick"], "rhel": ["ImageMagick"]}},
        {"id": "msmtp", "packages": {"alpine": ["msmtp"], "debian": ["msmtp"], "rhel": ["msmtp"]}},
