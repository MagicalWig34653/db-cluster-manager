EOF
			chmod 0755 /usr/local/bin/dbcm-e8-proxycheck
			cat >/etc/keepalived/keepalived.conf <<EOF
global_defs {
  script_user root
  router_id $(hostname)
}
vrrp_script chk_proxy {
  script "/usr/local/bin/dbcm-e8-proxycheck"
  interval 1
  timeout 2
  fall 2
  rise 2
}
vrrp_instance DBCM_E8 {
  state BACKUP
  interface $1
  virtual_router_id 61
  priority $4
  nopreempt
  advert_int 1
  unicast_src_ip $2
  unicast_peer {
    $3
  }
  virtual_ipaddress {
    $5/24 dev $1
  }
  track_script {
    chk_proxy
  }
}
EOF
