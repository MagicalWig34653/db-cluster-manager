  lima:thermoctl-e2e-basestation
  lima:thermoctl-test-vm
(exit 0)
```

### bin/lab apply -apply -vms 3 -cpus 2 -ram 4 -disk 20

```
$ <repo>/bin/lab apply -apply -vms 3 -cpus 2 -ram 4 -disk 20
pre-snapshot:
  colima:default
  lima:thermoctl-e2e-basestation
  lima:thermoctl-test-vm
executing actions:
  # create Lima VM dbcm-lab-m1 (2 CPUs, 4 GiB RAM, 20 GiB disk, template docker)
  limactl create --name=dbcm-lab-m1 --cpus=2 --memory=4 --disk=20 --tty=false template:docker
  # start Lima VM dbcm-lab-m1
  limactl start --tty=false dbcm-lab-m1
  # create Lima VM dbcm-lab-m2 (2 CPUs, 4 GiB RAM, 20 GiB disk, template docker)
  limactl create --name=dbcm-lab-m2 --cpus=2 --memory=4 --disk=20 --tty=false template:docker
  # start Lima VM dbcm-lab-m2
  limactl start --tty=false dbcm-lab-m2
  # create Lima VM dbcm-lab-m3 (2 CPUs, 4 GiB RAM, 20 GiB disk, template docker)
  limactl create --name=dbcm-lab-m3 --cpus=2 --memory=4 --disk=20 --tty=false template:docker
  # start Lima VM dbcm-lab-m3
  limactl start --tty=false dbcm-lab-m3
post-snapshot diff:
  added: lima:dbcm-lab-m1, lima:dbcm-lab-m2, lima:dbcm-lab-m3
  removed: (none)
(exit 0)
```

### host free disk after apply

```
$ host_free_disk
host free disk (/System/Volumes/Data): 74Gi of 926Gi
(exit 0)
```


## Step 1b: guest preparation (lab VMs only)

### default network of dbcm-lab-m1

```
$ vm_sh dbcm-lab-m1 ip -4 -o addr show eth0 | awk "{print \$2, \$4}"
eth0 192.168.5.15/24
(exit 0)
```

### default network of dbcm-lab-m2

```
$ vm_sh dbcm-lab-m2 ip -4 -o addr show eth0 | awk "{print \$2, \$4}"
eth0 192.168.5.15/24
(exit 0)
```

### default network of dbcm-lab-m3

```
$ vm_sh dbcm-lab-m3 ip -4 -o addr show eth0 | awk "{print \$2, \$4}"
eth0 192.168.5.15/24
(exit 0)
```

