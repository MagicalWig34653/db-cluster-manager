  logical CPUs: 14
  RAM: 48.0 GiB
budget:
  lab CPU limit: 7
  lab RAM limit: 16.0 GiB
  lab disk limit: 100.0 GiB
manifest .lab/manifest.json:
  (empty)
inventory:
  colima:default
  lima:thermoctl-e2e-basestation
  lima:thermoctl-test-vm
unrelated (never touched):
