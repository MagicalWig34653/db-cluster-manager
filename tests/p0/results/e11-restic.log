## Backend host (m2): users, TLS, rest-server, MinIO

### copy MinIO to m2

```
$ limactl cp ~/go/bin/linux_arm64/minio dbcm-lab-m2:/tmp/minio
(exit 0)
```

### install MinIO on m2

```
$ m2x install -m 0755 /tmp/minio /usr/local/bin/minio && /usr/local/bin/minio --version | head -1
minio version DEVELOPMENT.GOGET (commit-id=DEVELOPMENT.GOGET)
(exit 0)
```

### rest-server on m2 (checksum verified)

```
$ m2x cd /tmp && curl -fsSL -o rs.tgz https://github.com/restic/rest-server/releases/download/v0.14.0/rest-server_0.14.0_linux_arm64.tar.gz && echo 'cef139cbe8b27b16bda731d17f093b0aa466b8c60b136c12d78b6f2bff3daf22  rs.tgz' | sha256sum -c - && tar -xzf rs.tgz --strip-components=1 -C /tmp rest-server_0.14.0_linux_arm64/rest-server && install -m 0755 /tmp/rest-server /usr/local/bin/rest-server && rest-server --version
rs.tgz: OK
rest-server version rest-server 0.14.0 compiled with go1.24.3 on linux/arm64

(exit 0)
```

### users and directories on m2

```
$ m2x 
	set -e
	for u in e11backup e11ext; do id $u >/dev/null 2>&1 || useradd -m -s /bin/bash $u; install -d -m 700 -o $u -g $u /home/$u/.ssh; done
	install -d -o e11backup -g e11backup /srv/e11-sftp
	install -d -o e11ext -g e11ext /srv/e11ext /srv/e11ext/data /srv/e11ext/data/skip /srv/e11ext/repo
	install -d /srv/e11-rest /srv/e11-minio /etc/e11-tls /etc/e11-tls/minio/certs
	id e11backup e11ext
uid=1000(e11backup) gid=1001(e11backup) groups=1001(e11backup)
uid=1001(e11ext) gid=1002(e11ext) groups=1002(e11ext)
(exit 0)
```

### TLS certificate on m2 (self-signed, SAN lima-dbcm-lab-m2.internal)

```
$ m2x 
	set -e
	openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 2 -subj /CN=lima-dbcm-lab-m2.internal 		-addext subjectAltName=DNS:lima-dbcm-lab-m2.internal -keyout /etc/e11-tls/key.pem -out /etc/e11-tls/cert.pem 2>/dev/null
	cp /etc/e11-tls/cert.pem /etc/e11-tls/minio/certs/public.crt; cp /etc/e11-tls/key.pem /etc/e11-tls/minio/certs/private.key
	openssl x509 -in /etc/e11-tls/cert.pem -noout -subject -ext subjectAltName -enddate
subject=CN = lima-dbcm-lab-m2.internal
X509v3 Subject Alternative Name: 
    DNS:lima-dbcm-lab-m2.internal
notAfter=Oct 29 11:38:13 2026 GMT
(exit 0)
```

### apache2-utils on m2 (htpasswd)

```
$ vm_sh dbcm-lab-m2 sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq apache2-utils >/dev/null 2>&1; which htpasswd
/usr/bin/htpasswd
(exit 0)
```

### start rest-server (TLS, htpasswd) on m2

```
$ m2x systemd-run --unit=e11-rest rest-server --path /srv/e11-rest --listen :8000 --tls --tls-cert /etc/e11-tls/cert.pem --tls-key /etc/e11-tls/key.pem --htpasswd-file /etc/e11-tls/htpasswd >/dev/null 2>&1; sleep 2; systemctl is-active e11-rest
active
(exit 0)
```

### start MinIO (TLS) on m2

```
$ m2x cat >/etc/systemd/system/e11-minio.service <<EOF
[Service]
EnvironmentFile=/etc/e11-tls/minio.env
ExecStart=/usr/local/bin/minio server /srv/e11-minio --certs-dir /etc/e11-tls/minio/certs --address :9000 --console-address :9001
EOF
systemctl daemon-reload; systemctl start e11-minio; sleep 5; systemctl is-active e11-minio
active
(exit 0)
```

### TLS health of rest-server and MinIO from m2

```
$ m2x curl -sS --cacert /etc/e11-tls/cert.pem -o /dev/null -w 'rest %{http_code}\n' https://lima-dbcm-lab-m2.internal:8000/ ; curl -sS --cacert /etc/e11-tls/cert.pem -o /dev/null -w 'minio %{http_code}\n' https://lima-dbcm-lab-m2.internal:9000/minio/health/live
rest 401
minio 200
(exit 0)
```


## Keys and trust (m1 -> m2)

### m1 keys

```
$ m1x set -e; install -d -m 700 /root/.ssh; [ -f /root/.ssh/id_ed25519 ] || ssh-keygen -q -t ed25519 -N "" -f /root/.ssh/id_ed25519; [ -f /root/e11ext_key ] || ssh-keygen -q -t ed25519 -N "" -f /root/e11ext_key; ssh-keyscan -t ed25519 lima-dbcm-lab-m2.internal >/root/.ssh/known_hosts 2>/dev/null; cp /root/.ssh/known_hosts /root/e11_known_hosts; wc -l /root/.ssh/known_hosts
1 /root/.ssh/known_hosts
(exit 0)
```

### authorize keys on m2

```
$ m2x set -e
	printf '%s\n' 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILz6ap2ph6RsFFDaMEWSIdQPlRX82j9Mwae0w9yswKTL root@lima-dbcm-lab-m1' >/home/e11backup/.ssh/authorized_keys; chown e11backup:e11backup /home/e11backup/.ssh/authorized_keys; chmod 600 /home/e11backup/.ssh/authorized_keys
	printf '%s\n' 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGEABW1lmBTGAvlaWdfKl1qwVTZuX6MDBfKBiFbn48Ju root@lima-dbcm-lab-m1' >/home/e11ext/.ssh/authorized_keys; chown e11ext:e11ext /home/e11ext/.ssh/authorized_keys; chmod 600 /home/e11ext/.ssh/authorized_keys
	echo ok
ok
(exit 0)
```

### ssh m1 -> m2 as e11backup

```
$ m1x ssh -o BatchMode=yes e11backup@lima-dbcm-lab-m2.internal 'id -un'
e11backup
(exit 0)
```

### CA copied to m1

```
$ m1x openssl x509 -in /root/e11-ca.pem -noout -subject
subject=CN = lima-dbcm-lab-m2.internal
(exit 0)
```


