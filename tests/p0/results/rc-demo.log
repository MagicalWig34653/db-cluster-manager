### volume dbcm_manager-data-1 on dbcm-lab-m1: own peer bundle and the shared proxy tokens, owned by 65532

```
$ sh -c limactl shell --workdir / dbcm-lab-m1 -- sudo tar -C /root/dbcm-e4 -cf - peers/manager-1/peer-bundle.pem tokens | limactl shell --workdir / dbcm-lab-m1 -- sudo sh -c '
				set -e
				docker volume create dbcm_manager-data-1 >/dev/null
				mp=$(docker volume inspect -f "{{.Mountpoint}}" dbcm_manager-data-1)
				d=$(mktemp -d) && tar -C $d -xf -
				install -d -m 0700 $mp/peer $mp/proxy
				install -m 0600 $d/peers/manager-1/peer-bundle.pem $mp/peer/peer-bundle.pem
				for t in proxy-a proxy-b admin; do install -m 0600 $d/tokens/$t.token $mp/proxy/$t.token; done
				rm -rf $d
				chown -R 65532:65532 $mp
				ls -lnR $mp | cut -c1-60'
