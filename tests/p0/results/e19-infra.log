## Phase minio: private CA, two MinIO servers with TLS (m2 main, m3 copy target), backend files and Swarm secrets

host uptime:  8:08  up 13 days, 17:07, 13 users, load averages: 25.43 52.82 54.25

07:08:19Z host load: { 25.43 52.82 54.25 }
07:08:19Z m2 192.168.104.3  m3 192.168.104.4
### CA and server certificates (made in m1)

```
$ vm_root dbcm-lab-m1 
		set -e
		d="$1/pki"; install -d -m 0700 "$d"; cd "$d"
		if [ ! -f ca.pem ]; then
			openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -keyout ca.key -out ca.pem -days 30 -subj "/CN=dbcm-e19-lab-ca" 2>/dev/null
			for n in m2:"$2" m3:"$3"; do
				name=${n%%:*}; ip=${n#*:}
				openssl req -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -keyout "$name.key" -out "$name.csr" -subj "/CN=$name" 2>/dev/null
				printf "subjectAltName=IP:%s\nextendedKeyUsage=serverAuth\n" "$ip" >"$name.ext"
				openssl x509 -req -in "$name.csr" -CA ca.pem -CAkey ca.key -CAcreateserial -out "$name.crt" -days 30 -extfile "$name.ext" 2>/dev/null
			done
		fi
		ls -l; openssl x509 -in ca.pem -noout -subject -enddate; openssl x509 -in m2.crt -noout -subject -issuer -ext subjectAltName /root/dbcm-e4 192.168.104.3 192.168.104.4
