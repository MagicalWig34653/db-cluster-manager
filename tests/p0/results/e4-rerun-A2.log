USER 65532:65532
ENTRYPOINT ["/usr/local/bin/manager"]
CMD ["-listen", "0.0.0.0:8080"]
EOF gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
