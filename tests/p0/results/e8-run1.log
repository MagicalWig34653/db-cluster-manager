### keepalived check script and configuration on dbcm-lab-m2

```
$ vm_root dbcm-lab-m2 
			set -e
			cat >/usr/local/bin/dbcm-e8-proxycheck <<EOF
#!/bin/sh
# healthy = the local proxy container reports a writer
docker exec $6 /e8/e5client status | grep -Eq "has_writer\"?: *true"
EOF
			chmod 0755 /usr/local/bin/dbcm-e8-proxycheck
			cat >/etc/keepalived/keepalived.conf <<EOF
global_defs {
  script_user root
  router_id $(hostname)
}
vrrp_script chk_proxy {
  script "/usr/local/bin/dbcm-e8-proxycheck"
  interval 1
  timeout 2
  fall 2
  rise 2
}
vrrp_instance DBCM_E8 {
  state BACKUP
  interface $1
  virtual_router_id 61
  priority $4
  nopreempt
  advert_int 1
  unicast_src_ip $2
  unicast_peer {
    $3
  }
  virtual_ipaddress {
    $5/24 dev $1
  }
  track_script {
    chk_proxy
  }
}
EOF
			cat /etc/keepalived/keepalived.conf
			systemctl enable --now keepalived >/dev/null 2>&1
			systemctl restart keepalived
			sleep 1; systemctl is-active keepalived eth0 192.168.104.3 192.168.104.4 150 192.168.104.250 dbcm-e8-proxy
global_defs {
  script_user root
  router_id lima-dbcm-lab-m2
}
vrrp_script chk_proxy {
  script "/usr/local/bin/dbcm-e8-proxycheck"
  interval 1
  timeout 2
  fall 2
  rise 2
}
vrrp_instance DBCM_E8 {
  state BACKUP
  interface eth0
  virtual_router_id 61
  priority 150
  nopreempt
  advert_int 1
  unicast_src_ip 192.168.104.3
  unicast_peer {
    192.168.104.4
  }
  virtual_ipaddress {
    192.168.104.250/24 dev eth0
  }
  track_script {
    chk_proxy
  }
}
active
(exit 0)
