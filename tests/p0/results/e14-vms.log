### bin/lab apply -apply -vms 3 -cpus 2 -ram 4 -disk 20 -network lima:user-v2

```
$ <repo>/bin/lab apply -apply -vms 3 -cpus 2 -ram 4 -disk 20 -network lima:user-v2
pre-snapshot:
  colima:default
  lima:thermoctl-e2e-basestation
  lima:thermoctl-test-vm
executing actions:
  # create Lima VM dbcm-lab-m1 (2 CPUs, 4 GiB RAM, 20 GiB disk, template docker, network lima:user-v2 (shared Lima state, not owned))
  limactl create --name=dbcm-lab-m1 --cpus=2 --memory=4 --disk=20 --tty=false --network=lima:user-v2 template:docker
  # start Lima VM dbcm-lab-m1
  limactl start --tty=false dbcm-lab-m1
  # create Lima VM dbcm-lab-m2 (2 CPUs, 4 GiB RAM, 20 GiB disk, template docker, network lima:user-v2 (shared Lima state, not owned))
  limactl create --name=dbcm-lab-m2 --cpus=2 --memory=4 --disk=20 --tty=false --network=lima:user-v2 template:docker
  # start Lima VM dbcm-lab-m2
  limactl start --tty=false dbcm-lab-m2
  # create Lima VM dbcm-lab-m3 (2 CPUs, 4 GiB RAM, 20 GiB disk, template docker, network lima:user-v2 (shared Lima state, not owned))
  limactl create --name=dbcm-lab-m3 --cpus=2 --memory=4 --disk=20 --tty=false --network=lima:user-v2 template:docker
  # start Lima VM dbcm-lab-m3
  limactl start --tty=false dbcm-lab-m3
post-snapshot diff:
  added: lima:dbcm-lab-m1, lima:dbcm-lab-m2, lima:dbcm-lab-m3
  removed: (none)
(exit 0)
```

### switch dbcm-lab-m1 to rootful docker

```
$ vm_sh dbcm-lab-m1 
			set -e
			systemctl --user disable --now docker.service >/dev/null 2>&1 || true
			sudo systemctl unmask containerd.service docker.service docker.socket >/dev/null 2>&1
			sudo systemctl enable --now containerd.service docker.socket docker.service >/dev/null 2>&1
			echo "rootful docker: $(systemctl is-active docker.service)"
rootful docker: active
(exit 0)
```

