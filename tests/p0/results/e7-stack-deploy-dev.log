      ]
    },
    "settings": {
      "installationId": "e7lab",
      "volumeBase": "/var/lib/dbcm/volumes",
      "agentImage": "db-cluster-manager:e7",
      "monitorSocket": "",
      "accounts": {
        "monitorUser": "dbcm_monitor",
        "monitorSecret": "dbcm-e7lab-monitor-pw",
        "backupUser": "dbcm_backup",
